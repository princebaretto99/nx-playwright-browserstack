t) => {\n      if (result.status === 'success') {\n        console.info(\"Scanner is now ready on the page after multiple retries.\");\n        getAccessibilityResultsSummary();\n      }\n    })\n    .catch((error) => {\n      console.error(\"Scanner is not ready on the page after multiple retries.\", error);\n      callback({ success: false, msg: \"Scanner is not ready on the page after multiple retries.\" });\n    });\n} else {\n  console.warn(\"Unable to fetch accessibility results summary, Invalid URL.\");\n  callback({ success: false, msg: \"Unable to fetch accessibility results summary, Invalid URL.\" });\n}\n"}],"commandsToWrap":{"scriptsToRun":["scan","saveResults","getResults","getResultsSummary"],"commands":[{"library":"playwright","method":"sendMessageToServer","module":"lib/client/connection.js","name":"goto","class":"Connection"},{"library":"playwright","method":"sendMessageToServer","module":"lib/client/connection.js","name":"addInitScript","class":"Connection"},{"library":"playwright","method":"sendMessageToServer","module":"lib/client/connection.js","name":"addScriptTag","class":"Connection"},{"library":"playwright","method":"sendMessageToServer","module":"lib/client/connection.js","name":"addStyleTag","class":"Connection"},{"library":"playwright","method":"sendMessageToServer","module":"lib/client/connection.js","name":"bringToFront","class":"Connection"},{"library":"playwright","method":"sendMessageToServer","module":"lib/client/connection.js","name":"close","class":"Connection"},{"library":"playwright","method":"sendMessageToServer","module":"lib/client/connection.js","name":"dragAndDrop","class":"Connection"},{"library":"playwright","method":"sendMessageToServer","module":"lib/client/connection.js","name":"evaluateHandle","class":"Connection"},{"library":"playwright","method":"sendMessageToServer","module":"lib/client/connection.js","name":"goBack","class":"Connection"},{"library":"playwright","method":"sendMessageToServer","module":"lib/client/c